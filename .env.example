# Copy to .env and fill in your values.  The real .env is git-ignored.

# development | production
# In production the app refuses to start with a missing/weak JWT_SECRET.
NODE_ENV=development
PORT=4000

# MySQL connection.
# In production, use a dedicated user with a strong password — not root.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_saas

# Comma-separated list of allowed CORS origins (frontend dev server, prod URL…)
CORS_ORIGIN=http://localhost:5173

# The domain customers are given. Used for password-reset links, and served to
# the dashboard (GET /api/public/config) so storefront QR codes carry this
# domain rather than whichever hostname the merchant opened the dashboard on.
# Falls back to the first CORS_ORIGIN if unset.
APP_URL=http://localhost:5173

# Outbound email. With no SMTP_HOST the password-reset link is logged to the
# server console instead of sent — fine for local development, and warned about
# loudly in production, where it means resets are reaching nobody.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Rate limiting. Auth limits count only FAILED attempts, so signing in and out
# repeatedly never locks you out. Public limits cover storefront review/order
# writes; menu browsing (GET) is never throttled.
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PUBLIC_WINDOW_MIN=10
RATE_LIMIT_PUBLIC_MAX=40

# How many reverse proxies sit in front of the app. Defaults to 1 in production
# (Railway/Render/Nginx) and 0 otherwise. Getting this wrong makes every request
# look like it comes from the proxy, so one bad actor rate-limits everyone.
TRUST_PROXY=

# First-run bootstrap (npm run db:bootstrap). Leave SEED_ADMIN_PASSWORD unset to
# have a strong one generated and printed once — there is no default password.
SEED_ADMIN_EMAIL=admin@restosaas.com
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_PASSWORD=

# JWT signing secret — REQUIRED in production, must be strong and unique.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
